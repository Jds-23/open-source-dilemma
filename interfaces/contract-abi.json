{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSD dilemma contract ABI (interfaces-v7)",
  "description": "Hand-written frozen interface; see INTERFACE.md. Not the near-abi format. JSON args/returns.",
  "version": "interfaces-v7",
  "contract_testnet": "osd.baldingsucks7993.testnet",
  "near_sdk": "5.9.0",
  "rustc": "1.85.0",
  "constants": {
    "AGENT_ACCOUNT_FUNDING": "200000000000000000000000",
    "MIN_REGISTER_DEPOSIT": "250000000000000000000000",
    "FC_KEY_ALLOWANCE": "250000000000000000000000",
    "MIN_OUTLAYER_DEPOSIT": "20000000000000000000000",
    "MIN_PLAY_GAS_TGAS": 210,
    "STALE_PENDING_BLOCKS": 250,
    "MAX_AGENTS": 40,
    "MAX_PROMPT_BYTES": 4000,
    "MAX_CIPHERTEXT_HEX": 8400,
    "STAKE_UNITS_PER_MATCH": 3,
    "PAYOFF": {
      "CC": [
        3,
        3,
        0
      ],
      "DC": [
        5,
        1,
        0
      ],
      "CD": [
        1,
        5,
        0
      ],
      "DD": [
        1,
        1,
        4
      ],
      "FX": [
        0,
        3,
        3
      ],
      "XF": [
        3,
        0,
        3
      ],
      "FF": [
        0,
        0,
        6
      ]
    },
    "SEAL_CONFIRM": "SEAL-FOREVER",
    "MAX_SEAL_KEYS": 32
  },
  "methods": [
    {
      "name": "new",
      "kind": "init",
      "caller": "deployer, becomes owner",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "wasm_url",
          "wasm_hash",
          "secrets_owner",
          "secrets_profile",
          "nearai_signer",
          "outlayer_account"
        ],
        "properties": {
          "wasm_url": {
            "type": "string"
          },
          "wasm_hash": {
            "type": "string"
          },
          "secrets_owner": {
            "$ref": "#/$defs/AccountId"
          },
          "secrets_profile": {
            "type": "string"
          },
          "nearai_signer": {
            "$ref": "#/$defs/Hex64"
          },
          "outlayer_account": {
            "$ref": "#/$defs/AccountId"
          }
        }
      },
      "returns": {
        "type": "null"
      }
    },
    {
      "name": "register_agent",
      "kind": "call",
      "payable": ">= 0.25 NEAR (0.2 NEAR to sub-account, rest to budget)",
      "caller": "owner of the new agent",
      "effects": "creates <name>.<contract>; adds FC key receiver=contract methods=[commit,claim] allowance=0.25 NEAR; emits agent_registered",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "agent_public_key"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{2,16}$"
          },
          "agent_public_key": {
            "type": "string",
            "pattern": "^ed25519:"
          }
        }
      },
      "returns": {
        "$ref": "#/$defs/AccountId"
      }
    },
    {
      "name": "fund_agent",
      "kind": "call",
      "payable": "> 0",
      "caller": "anyone",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id"
        ],
        "properties": {
          "agent_id": {
            "$ref": "#/$defs/AccountId"
          }
        }
      },
      "returns": {
        "$ref": "#/$defs/U128"
      }
    },
    {
      "name": "withdraw",
      "kind": "call",
      "payable": "1 yocto",
      "caller": "agent owner",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "amount_yocto"
        ],
        "properties": {
          "agent_id": {
            "$ref": "#/$defs/AccountId"
          },
          "amount_yocto": {
            "$ref": "#/$defs/U128"
          }
        }
      },
      "returns": {
        "$ref": "#/$defs/U128"
      }
    },
    {
      "name": "open_season",
      "kind": "call",
      "payable": ">= 0.02 NEAR (OutLayer derive_pubkey)",
      "caller": "contract owner",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "params"
        ],
        "properties": {
          "params": {
            "$ref": "#/$defs/SeasonParams"
          },
          "wasm_url": {
            "type": "string",
            "description": "optional per-season override of config wasm_url; must come with wasm_hash"
          },
          "wasm_hash": {
            "type": "string",
            "description": "optional per-season override of config wasm_hash; must come with wasm_url"
          },
          "secrets_profile": {
            "type": "string",
            "description": "optional per-season override of config secrets_profile"
          }
        }
      },
      "returns": {
        "type": "integer",
        "minimum": 0
      },
      "effects": "creates season (status pending_key) with wasm{url,hash} + secrets_profile pinned (overrides or config); pool starts at the pending carry-over; detached OutLayer derive_pubkey -> on_pubkey. Allowed when the previous season is settled, cancelled or key_failed. After seal: any wasm_url/wasm_hash/secrets_profile override is refused (\"sealed: per-season ... overrides are disabled\"); only the config referee"
    },
    {
      "name": "on_pubkey",
      "kind": "call",
      "private": true,
      "callback_result": {
        "$ref": "wasm-io.schema.json#/$defs/pubkey_output"
      },
      "effects": "stores pubkey; status commit; emits season_opened (or status key_failed)",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season_id"
        ],
        "properties": {
          "season_id": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "returns": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "guard": "requires env::promise_results_count() == 1, else panics \"not a callback\" (a tx signed with the contract account's own key passes #[private] but has no promise result). Same guard on the internal on_agent_created callback"
    },
    {
      "name": "commit",
      "kind": "call",
      "caller": "agent account (FC key) or its owner",
      "effects": "debits entry_deposit_yocto from budget; emits committed. Refuses: status != commit; past deadline; agent already entered; owner at max_entries_per_owner; max_agents reached; budget < entry_deposit_yocto; bad hex/size; bad family. No duplicate check on chain (commitments are salted): duplicate prompts are voided by the TEE (duplicate_prompt) Refuses parent.season_id < 1.",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season_id",
          "agent_id",
          "ciphertext_hex",
          "commitment",
          "family",
          "parent"
        ],
        "properties": {
          "season_id": {
            "type": "integer",
            "minimum": 0
          },
          "agent_id": {
            "$ref": "#/$defs/AccountId"
          },
          "ciphertext_hex": {
            "type": "string",
            "maxLength": 8400
          },
          "commitment": {
            "$ref": "#/$defs/Commitment"
          },
          "family": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,32}$"
          },
          "parent": {
            "$ref": "#/$defs/Parent"
          }
        }
      },
      "returns": {
        "type": "null"
      }
    },
    {
      "name": "close_commits",
      "kind": "call",
      "caller": "anyone, after commit_deadline_ns",
      "effects": "status play (or cancelled if < 2 entries); emits commits_closed",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season_id"
        ],
        "properties": {
          "season_id": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "returns": {
        "type": "integer",
        "minimum": 0
      }
    },
    {
      "name": "schedule_round",
      "kind": "call",
      "caller": "anyone",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season_id"
        ],
        "properties": {
          "season_id": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "returns": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/MatchKey"
        }
      }
    },
    {
      "name": "play_match",
      "kind": "call",
      "payable": ">= 0.02 NEAR (OutLayer; unused refunded to caller)",
      "caller": "anyone (keeper)",
      "effects": "scheduled -> pending; OutLayer request_execution with pinned WasmUrl{url,hash} + secrets_ref; uses the season's pinned wasm/secrets_profile; accepted while status = play (also after play_deadline_ns)",
      "gas": "v7 (F2): prepaid gas >= MIN_PLAY_GAS = 210 Tgas (OutLayer 150 static + all unused, on_match 40 static, own 20), else panics 'insufficient gas: attach at least 210 Tgas' before any state change (match stays scheduled). Keeper attaches 300 Tgas.",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season_id",
          "a",
          "b"
        ],
        "properties": {
          "season_id": {
            "type": "integer",
            "minimum": 0
          },
          "a": {
            "$ref": "#/$defs/AccountId"
          },
          "b": {
            "$ref": "#/$defs/AccountId"
          }
        }
      },
      "returns": {
        "type": "string"
      }
    },
    {
      "name": "on_match",
      "kind": "call",
      "private": true,
      "callback_result": {
        "$ref": "#/$defs/WasmOutput"
      },
      "effects": "pending -> settled|void (never retried); emits match_played|match_void",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season_id",
          "a",
          "b"
        ],
        "properties": {
          "season_id": {
            "type": "integer",
            "minimum": 0
          },
          "a": {
            "$ref": "#/$defs/AccountId"
          },
          "b": {
            "$ref": "#/$defs/AccountId"
          }
        }
      },
      "returns": {
        "type": "string"
      },
      "guard": "requires env::promise_results_count() == 1, else panics \"not a callback\" (a tx signed with the contract account's own key passes #[private] but has no promise result). Same guard on the internal on_agent_created callback"
    },
    {
      "name": "refund_void",
      "kind": "call",
      "caller": "anyone",
      "effects": "void (or pending > 250 blocks) -> refunded; credits 3 units per side",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season_id",
          "a",
          "b"
        ],
        "properties": {
          "season_id": {
            "type": "integer",
            "minimum": 0
          },
          "a": {
            "$ref": "#/$defs/AccountId"
          },
          "b": {
            "$ref": "#/$defs/AccountId"
          }
        }
      },
      "returns": {
        "$ref": "#/$defs/U128"
      }
    },
    {
      "name": "settle_season",
      "kind": "call",
      "caller": "anyone",
      "effects": "ranks vs distinct owners; pays pool by prize_split_bps (floor); unpaid remainder -> carry_over for the next season; returns bonds; emits season_settled. After the play deadline, unfinished matches are voided + refunded at most 40 per call (receipt log limit): returns [] (status stays play) until the final call returns the ranking",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season_id"
        ],
        "properties": {
          "season_id": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "returns": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/LeaderboardRow"
        }
      }
    },
    {
      "name": "claim",
      "kind": "call",
      "caller": "agent account (FC key) or its owner",
      "effects": "claimable -> budget",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season_id",
          "agent_id"
        ],
        "properties": {
          "season_id": {
            "type": "integer",
            "minimum": 0
          },
          "agent_id": {
            "$ref": "#/$defs/AccountId"
          }
        }
      },
      "returns": {
        "$ref": "#/$defs/U128"
      }
    },
    {
      "name": "publish_prompt",
      "kind": "call",
      "caller": "agent owner, after settle",
      "effects": "checks sha256(utf8(prompt) || salt || utf8(agent_id)) == entry.commitment; stores {prompt, salt} (first publish fixes the list position; re-publish allowed) (readable via get_published_prompts); emits prompt_published",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season_id",
          "agent_id",
          "prompt",
          "salt"
        ],
        "properties": {
          "season_id": {
            "type": "integer",
            "minimum": 0
          },
          "agent_id": {
            "$ref": "#/$defs/AccountId"
          },
          "prompt": {
            "type": "string",
            "maxLength": 4000
          },
          "salt": {
            "$ref": "#/$defs/Hex64",
            "description": "the 32-byte salt from the ECIES plaintext"
          }
        }
      },
      "returns": {
        "type": "null"
      }
    },
    {
      "name": "set_secrets",
      "kind": "call",
      "caller": "contract owner (get_config.owner)",
      "deposit": "exactly 1 yoctoNEAR",
      "effects": "interfaces-v6. Refused after seal (\"sealed: the secrets ref is frozen\"), so one way. Sets config secrets_owner + secrets_profile (the OutLayer secrets_ref owner/profile) for seasons opened from now on; seasons already opened keep their pinned ref. Emits secrets_set. Intended use before seal: point at a profile owned by the contract account itself so nobody can modify it after seal. The contract does not check the row exists: verify with outlayer keystore list_user_secrets first",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "profile"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "description": "AccountId that stored the OutLayer secrets row (the keystore store_secrets signer)"
          },
          "profile": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          }
        }
      },
      "returns": {
        "type": "null"
      }
    },
    {
      "name": "seal",
      "kind": "call",
      "caller": "contract owner (get_config.owner)",
      "deposit": "exactly 1 yoctoNEAR",
      "effects": "one way. confirm must equal \"SEAL-FOREVER\"; refused if already sealed. Schedules one batch on the contract account deleting every listed access key (pass the full RPC view_access_key_list; the contract cannot enumerate its keys) -> on_sealed sets the permanent seal flag and emits contract_sealed. If any listed key is missing the batch fails, no key is deleted, the contract stays unsealed and the call returns false. Empty list: sealed at once. After seal: no code-deploy path (the contract has no upgrade method and no keys), open_season overrides and set_secrets refused. Verify with view_access_key_list == []",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "public_keys",
          "confirm"
        ],
        "properties": {
          "public_keys": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "description": "\"ed25519:<base58>\""
            }
          },
          "confirm": {
            "const": "SEAL-FOREVER"
          }
        }
      },
      "returns": {
        "type": "boolean",
        "description": "promise result: true when sealed"
      }
    },
    {
      "name": "on_sealed",
      "kind": "call",
      "private": true,
      "guard": "requires exactly one promise result (\"not a callback\")",
      "effects": "key batch succeeded -> sets the seal flag, emits contract_sealed; failed -> logs, stays unsealed",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "public_keys"
        ],
        "properties": {
          "public_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "returns": {
        "type": "boolean"
      }
    },
    {
      "name": "get_config",
      "kind": "view",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      },
      "returns": {
        "$ref": "#/$defs/Config"
      }
    },
    {
      "name": "get_season",
      "kind": "view",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season_id"
        ],
        "properties": {
          "season_id": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "returns": {
        "oneOf": [
          {
            "$ref": "#/$defs/Season"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    {
      "name": "get_season_pubkey",
      "kind": "view",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season_id"
        ],
        "properties": {
          "season_id": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "returns": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^0[23][0-9a-f]{64}$"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    {
      "name": "get_entries",
      "kind": "view",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season_id"
        ],
        "properties": {
          "season_id": {
            "type": "integer",
            "minimum": 0
          },
          "from_index": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        }
      },
      "returns": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Entry"
        }
      }
    },
    {
      "name": "get_matches",
      "kind": "view",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season_id"
        ],
        "properties": {
          "season_id": {
            "type": "integer",
            "minimum": 0
          },
          "from_index": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "status": {
            "$ref": "#/$defs/MatchStatus"
          }
        }
      },
      "returns": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Match"
        }
      }
    },
    {
      "name": "get_leaderboard",
      "kind": "view",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season_id"
        ],
        "properties": {
          "season_id": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "returns": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/LeaderboardRow"
        }
      }
    },
    {
      "name": "get_agent",
      "kind": "view",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id"
        ],
        "properties": {
          "agent_id": {
            "$ref": "#/$defs/AccountId"
          }
        }
      },
      "returns": {
        "oneOf": [
          {
            "$ref": "#/$defs/Agent"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    {
      "name": "get_lineage",
      "kind": "view",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id"
        ],
        "properties": {
          "agent_id": {
            "$ref": "#/$defs/AccountId"
          }
        }
      },
      "returns": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/LineageEntry"
        }
      }
    },
    {
      "name": "get_claimable",
      "kind": "view",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season_id",
          "agent_id"
        ],
        "properties": {
          "season_id": {
            "type": "integer",
            "minimum": 0
          },
          "agent_id": {
            "$ref": "#/$defs/AccountId"
          }
        }
      },
      "returns": {
        "$ref": "#/$defs/U128"
      },
      "description": "claimable = unused stake + match payoffs + 3 units per void match + prize share + bond (bond withheld if the agent forfeited any match); WS-1 to confirm. Example: fixtures/claimable.json"
    },
    {
      "name": "get_published_prompts",
      "kind": "view",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season_id"
        ],
        "properties": {
          "season_id": {
            "type": "integer",
            "minimum": 0
          },
          "from_index": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        }
      },
      "returns": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/PublishedPrompt"
        }
      },
      "description": "first-publish order"
    },
    {
      "name": "is_sealed",
      "kind": "view",
      "args": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {}
      },
      "returns": {
        "type": "boolean"
      }
    }
  ],
  "$defs": {
    "U128": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "yoctoNEAR"
    },
    "U64": {
      "type": "string",
      "pattern": "^[0-9]+$",
      "description": "ns timestamp"
    },
    "AccountId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64
    },
    "Hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Commitment": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256(utf8(prompt) || salt[32] || utf8(agent_id)), lowercase hex; salt = 32 random client bytes carried inside the ECIES plaintext (INTERFACE.md §5)"
    },
    "Move": {
      "enum": [
        "C",
        "D",
        "F"
      ]
    },
    "Parent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "season_id",
            "agent_id"
          ],
          "properties": {
