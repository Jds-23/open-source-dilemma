    "forged-callback": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts forged-callback",
    "replay": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts replay",
    "agent-key": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/cli.ts agent-key",
