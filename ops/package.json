{
  "name": "@osd/ops",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "WS6: deploy, FastFS upload, secret profile, keeper, house agents, evidence export",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "lint": "tsc -p tsconfig.json && node scripts/shellcheck.mjs",
