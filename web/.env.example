# All optional. With nothing set the site runs on interfaces/fixtures (+ synthetic demo seasons).
# Read on-chain views instead of fixtures:
NEXT_PUBLIC_CONTRACT_ID=
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_NETWORK=testnet
# Optional match -> play_match tx index, from the WS-6 keeper journal. Either the output of
#   pnpm --filter @osd/ops export-tx-index --out tx-index.json   ->  {"version":1,"tx":{"<season_id>:<a>:<b>":"<tx hash>"}}
# or a raw ops/runs/<season>.jsonl (keeper records; uses kind=tx, method=play_match, outcome=ok). Prompts come from get_published_prompts.
NEXT_PUBLIC_INDEX_URL=
# Optional WS-8 NEP-245 cards contract (e.g. cards.osd.baldingsucks7993.testnet); unset -> cards hidden on agent pages.
NEXT_PUBLIC_CARDS_CONTRACT_ID=
# Sandbox (server-side only; never prefixed with NEXT_PUBLIC_). Missing key -> mock referee.
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=Qwen/Qwen3.8-27B
